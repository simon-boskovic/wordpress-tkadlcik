 "pick": [
  {
   "name": "browser prefers br, only gz stored",
   "pick": {
    "accept": "gzip, deflate, br, zstd",
    "br": false,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "br stored and accepted",
   "pick": {
    "accept": "gzip, deflate, br",
    "br": true,
    "gz": true
   },
   "expect": "br"
  },
  {
   "name": "gzip only",
   "pick": {
    "accept": "gzip",
    "br": true,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "identity",
   "pick": {
    "accept": "identity",
    "br": true,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "no header",
   "pick": {
    "accept": "",
    "br": true,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "nothing precompressed",
   "pick": {
    "accept": "gzip, br",
    "br": false,
    "gz": false
   },
   "expect": ""
  },
  {
   "name": "x-gzip counts (RFC 9110 alias of gzip)",
   "pick": {
    "accept": "x-gzip",
    "br": false,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "br as a substring does not count",
   "pick": {
    "accept": "brotli-ish, gzip",
    "br": true,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "case-insensitive",
   "pick": {
    "accept": "GZIP",
    "br": false,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "gzip;q=0 is refused",
   "pick": {
    "accept": "gzip;q=0, identity",
    "br": false,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "gzip; q=0.0 is refused",
   "pick": {
    "accept": "gzip; q=0.0",
    "br": false,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "gzip;q=0.5 is accepted",
   "pick": {
    "accept": "gzip;q=0.5",
    "br": false,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "gzip;q=0.001 is accepted",
   "pick": {
    "accept": "gzip;q=0.001",
    "br": false,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "br;q=0 falls back to gzip",
   "pick": {
    "accept": "br;q=0, gzip",
    "br": true,
    "gz": true
   },
   "expect": "gzip"
  },
  {
   "name": "GZIP;Q=0 is refused",
   "pick": {
    "accept": "GZIP;Q=0",
    "br": false,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "x-gzip;q=0 is refused",
   "pick": {
    "accept": "x-gzip;q=0",
    "br": false,
    "gz": true
   },
   "expect": ""
  },
  {
   "name": "br;q=0.000 is refused, no gzip stored",
   "pick": {
    "accept": "br;q=0.000",
    "br": true,
    "gz": false
   },
   "expect": ""
  },
  {
   "name": "br;q=0.0001 is not a valid q (more than 3 decimals) and counts",
   "pick": {
    "accept": "br;q=0.0001",
    "br": true,
    "gz": false
   },
   "expect": "br"
  },
  {
   "name": "br;q=1 accepted",
   "pick": {
    "accept": "gzip;q=0.5, br;q=1",
    "br": true,
    "gz": true
   },
   "expect": "br"
  }
