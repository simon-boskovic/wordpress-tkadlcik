            "html": "<section id=\"yang\" class=\"wrap section\">\n<div class=\"sec-head\">\n<div class=\"stack tk-s-f6ce4d1e\">\n<span class=\"idx\">03</span>\n<h2 class=\"h2\">Tchaj-ťi stylu <span class=\"serif\">Yang</span></h2>\n<a href=\"/kurzy-a-lekce/#kurz-yang\" class=\"lnk small tk-s-c9adc42e\">Rozvrh a ceny</a>\n</div>\n<p class=\"body tk-s-c0113872\">Výuka probíhá dle instrukcí a předání od mistra Vincenta Chu, který je hlavním instruktorem a mistrem bostonské školy <a href=\"https://www.gstaichi.org/\" rel=\"nofollow noopener\" target=\"_blank\" class=\"lnk\">Gin Soon Tai Chi Chuan Federation</a>. Jeho otec Chu Gin Soon byl osobním žákem mistra Yang Sau Chunga.</p>\n</div>\n<div class=\"card reveal tk-s-63558afc\">\n<h3 class=\"eyebrow tk-s-1815f59e\">Kompletní nabídka sestav a cvičení stylu Yang tchaj-ťi</h3>\n<ul class=\"tk-s-e1f4b352\">\n<li class=\"tk-s-d042bd76\"><span>Sestava Velkého řádu 12 forem – začátečnická sestava</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava Velkého řádu 43 forem</span></li>\n<li class=\"tk-s-d042bd76\"><span>Návrat k tchaj-ťi – krátká sestava</span></li>\n<li class=\"tk-s-d042bd76\"><span>Návrat k tchaj-ťi – dlouhá forma</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava Středního řádu 108 forem – tradiční sestava</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava Středního řádu 42 forem – zkrácená sestava</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava Středního řádu 22 forem – zkrácená sestava</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava s holí</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava s mečem</span></li>\n<li class=\"tk-s-d042bd76\"><span>Sestava se šavlí</span></li>\n<li class=\"tk-s-d042bd76\"><span>13 slov tchaj-ťi</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Osm kusů brokátu – základní forma, bojová forma</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Cvičení zhan zhuang – čchi-kungové statické cvičení 8 forem</span></li>\n<li class=\"tk-s-d042bd76\"><span>Čchi-kung tří kruhů</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Cvičení tří kruhů</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Tchaj-ťi kung – průpravná cvičení</span><span class=\"chip\">Vyučuji</span></li>\n<li class=\"tk-s-d042bd76\"><span>Rychlá forma</span></li>\n</ul>\n</div>\n</section>"
