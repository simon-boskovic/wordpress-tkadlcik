            "html": "<section id=\"nedele\" data-stage=\"wangmeng\" aria-labelledby=\"nedele-h\" class=\"sec\">\n<div class=\"sec-head\">\n<h2 id=\"nedele-h\" class=\"h2 reveal\">Celodenní cvičení v neděli</h2>\n<p class=\"body reveal\">Dopoledne procvičování Hrátky pěti zvířat a taichi-kung. Odpoledne procvičování sestav a stání v pozicích. Tělocvična ZŠ Jeremenkova, Jeremenkova 1003/66A, Praha 4.</p>\n</div>\n<div class=\"rows-group reveal\"><ul class=\"rows\">\n<li><span class=\"r-name\">Neděle 15. 11. 2026</span><span class=\"r-val\">10:00 - 12:30 a 15:00 - 17:30</span></li>\n<li><span class=\"r-name\">Neděle 13. 12. 2026</span><span class=\"r-val\">10:00 - 12:30 a 15:00 - 17:30</span></li>\n</ul></div>\n<div class=\"actions reveal tk-s-583f758b\"><a href=\"/kurzy-a-lekce/#nedele\" class=\"more\">Nabídka kurzů a lekcí <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" class=\"arr\"><path d=\"M3 8h10M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></a></div>\n</section>"
