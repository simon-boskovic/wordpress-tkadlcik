            "html": "<section id=\"rozvrh\" data-stage=\"peking\" aria-labelledby=\"rozvrh-h\" class=\"sec\">\n<div class=\"sheet-wrap reveal\">\n<div class=\"sheet\">\n<h2 id=\"rozvrh-h\" class=\"sheet-title\">Pravidelné cvičení</h2>\n<p class=\"sheet-note\">Tělocvična ZŠ Jeremenkova, Jeremenkova 1003/66A, Praha 4</p>\n<div class=\"sheet-group\">\n<h3>Pondělí</h3>\n<div class=\"sheet-item\"><span class=\"si-name\">Procvičování sestavy Yang 22 pohybů</span><span class=\"si-val\">18:00 - 20:00</span><span class=\"si-desc\">Náplň lekce průpravná cvičení taichi-kung, stání v pozicích ze sestavy. Výuka, opravy, procvičování pohybů.</span></div>\n<div class=\"sheet-item\"><span class=\"si-name\">Nový kurz od 7. 12. 2026</span><span class=\"si-val\">19:00 - 21:30</span><span class=\"si-desc\">Výuka Hrátky pěti zvířat, stání v pozicích Guo Yang Tzu, procvičování sestavy Yang tchaj-ťi 8 pohybů. Pro začátečníky.</span></div>\n</div>\n<div class=\"sheet-group\">\n<h3>Úterý</h3>\n<div class=\"sheet-item\"><span class=\"si-name\">Taichi-kung, procvičování dlouhá sestava</span><span class=\"si-val\">18:00 - 20:00</span></div>\n</div>\n<div class=\"sheet-group\">\n<h3>Čtvrtek</h3>\n<div class=\"sheet-item\"><span class=\"si-name\">Taichi-kung, procvičování dlouhá sestava</span><span class=\"si-val\">18:00 - 20:00</span></div>\n</div>\n<div class=\"sheet-group\">\n<h3>Neděle</h3>\n<div class=\"sheet-item\"><span class=\"si-name\">15. 11. 2026</span><span class=\"si-val\">10:00 - 12:30 a 15:00 - 17:30</span></div>\n<div class=\"sheet-item\"><span class=\"si-name\">13. 12. 2026</span><span class=\"si-val\">10:00 - 12:30 a 15:00 - 17:30</span></div>\n</div>\n<div class=\"sheet-group\">\n<h3>Cena</h3>\n<div class=\"sheet-item\"><span class=\"si-name\">Lekce 120 minut</span><span class=\"si-val\">350 Kč</span></div>\n<div class=\"sheet-item\"><span class=\"si-name\">10 lekcí</span><span class=\"si-val\">3 250 Kč</span><span class=\"si-desc\">Platby za lekci nebo 10 lekcí za 3 250 Kč, platba předem, platí na 3 měsíce od data zaplacení na účet.</span></div>\n<div class=\"sheet-item\"><span class=\"si-name\">Cvičení ve Zlíně</span><span class=\"si-val\">400 Kč</span><span class=\"si-desc\">1x měsíčně vždy v pátek, Centrum Jiný svět</span></div>\n</div>\n<p class=\"sheet-end\"><a href=\"/kurzy-a-lekce/\">Nabídka kurzů a lekcí</a></p>\n</div>\n</div>\n</section>"
