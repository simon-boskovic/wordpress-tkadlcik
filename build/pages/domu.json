            "html": "<section id=\"dech\" data-stage=\"hory\" aria-labelledby=\"dech-h\" class=\"sec\">\n<div class=\"sec-head\">\n<h2 id=\"dech-h\" class=\"h2 reveal\">Nádech a výdech</h2>\n\n</div>\n<div class=\"breath-box reveal\">\n<div data-breath data-phase=\"in\" class=\"breath\">\n<span aria-hidden=\"true\" class=\"breath-disc\"></span>\n<span aria-hidden=\"true\" class=\"breath-word\"><span class=\"in\">Nádech</span><span class=\"ex\">Výdech</span></span>\n</div>\n<div class=\"stack-l\">\n<p class=\"body\">Fyzický pohyb kombinovaný s principem dýchání tuina (nádech a výdech), tak aby energie mohla lépe cirkulovat uvnitř těla.</p>\n<div class=\"actions\"><button type=\"button\" data-breath-toggle aria-pressed=\"false\" class=\"btn btn-quiet\">Zastavit dech</button><span data-breath-count aria-live=\"off\" class=\"breath-count\"></span></div>\n</div>\n</div>\n</section>"
