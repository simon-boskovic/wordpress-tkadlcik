        {
          "id": "35c21a8",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<section class=\"wrap section\">\n<div class=\"sec-head\"><h2 class=\"h2\">Semináře <span class=\"serif\">a akce</span></h2></div>\n<div class=\"grid tk-s-ef649790\">\n<a href=\"/kurzy-a-lekce/#zlin\" class=\"card card-link reveal\">\n<span class=\"chip chip-neutral\">1x měsíčně vždy v pátek</span>\n<h3 class=\"h3 tk-s-583f758b\">Cvičení ve Zlíně</h3>\n<p class=\"body small\">Náplní kurzu je Osm kusů brokátu a 13 slov tchaj-ťi.</p>\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" class=\"arr tk-s-f55bb531\"><path d=\"M3 8h10M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n</a>\n<a href=\"/akce/#chu\" class=\"card card-link reveal\">\n<div class=\"tk-s-d30116a4\"><span class=\"chip chip-neutral tk-s-79128b79\">27. 11. – 29. 11. 2025</span><span class=\"chip\">Proběhlo</span></div>\n<h3 class=\"h3 tk-s-583f758b\">Seminář s mistrem Vincentem Chu</h3>\n<p class=\"body small\">Korektura dlouhé formy středního řádu. DaoYinový čchi-kung – Hrátky pěti zvířat.</p>\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" class=\"arr tk-s-f55bb531\"><path d=\"M3 8h10M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n</a>\n<a href=\"/akce/#hory\" class=\"card card-link reveal\">\n<span class=\"chip chip-neutral\">Strážné v Krkonoších</span>\n<h3 class=\"h3 tk-s-583f758b\">Cvičení na horách</h3>\n<p class=\"body small\">Cvičíme v příjemném prostředí Krkonoš.</p>\n<svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" class=\"arr tk-s-f55bb531\"><path d=\"M3 8h10M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n</a>\n</div>\n</section>"
